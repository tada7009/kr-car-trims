s":[{"cat":"외장","items":[{"n":"윈드쉴드 이중접합 차음 글라스","c":"KRTM312040"}]},{"cat":"내장","items":[{"n":"가죽 스티어링 휠(블랙 하이그로시 가니쉬 포함)","c":"KRTM312048"}]},{"cat":"시트","items":[{"n":"인조가죽시트","c":"KRTM312074"},{"n":"운전석 열선시트","c":"KRTM312071"},{"n":"운전석 시트 암레스트","c":"KRTM312068"},{"n":"운전석 시트 높이조절장치","c":"KRTM312067"},{"n":"운전석 시트벨트 높이조절장치","c":"KRTM312070"}]},{"cat":"편의","items":[{"n":"열선 스티어링 휠","c":"KRTM312091"},{"n":"뒷유리 와이퍼&와셔 노즐","c":"KRTM312079"}]}],"opts":[{"n":"스타일","c":"KRTM312P02","p":600000,"g":"옵션","note":""},{"n":"드라이브 와이즈","c":"KRTM312P07","p":300000,"g":"옵션","note":""}],"img":"https://www.kia.com/content/dam/kwp/kr/ko/vehicles/represent/krtm312/ray-ev_tmjv1vq3i_a_aeq.png"}],"notes":[]}],"packages":{"KRTM312P07":{"desc":"","items":[{"n":"안전 하차 경고","d":"정차 시, 탑승자가 하차를 위해 도어를 열 때 후측방에서 접근하는 차량과의 위험이 감지되면 경고해주는 기능입니다."},{"n":"후방 교차 충돌방지 보조","d":"후진 중 좌/우측에서 다가오는 차량과 충돌 위험이 감지되면 경고를 해주고, 경고 후에도 충돌 위험이 높아지면 자동으로 제동을 도와줍니다."},{"n":"후측방 충돌 경고","d":"차로 변경을 위하여 방향지시등 스위치 조작 시, 후측방 차량과 충돌 위험이 감지되면 경고를 해 줍니다."},{"n":"후측방 충돌방지 보조(전진 출차)","d":"차로 변경을 위하여 방향지시등 스위치 조작 시, 후측방 차량과 충돌 위험이 감지되면 경고를 해 줍니다. 평행 주차 상태에서 전진 출차 중 후측방 차량과 충돌 위험이 감지되면 자동으로 제동을 도와줍니다."}]},"KRTM312P09":{"desc":"","items":[{"n":"운전석 시트 높이조절장치","d":"시트 높이를 조절하여 운전자가 올바르고 편안한 운전 자세를 갖출 수 있도록 도와드립니다."},{"n":"운전석 시트 암레스트","d":"운전석의 시트에 팔을 올릴 수 있는 암레스트를 적용하여 편안한 드라이빙 환경을 제공합니다."},{"n":"운전석 시트벨트 높이조절장치","d":"시트벨트의 어깨 높이를 조절할 수 있어 몸에 맞는 시트벨트 착용이 가능합니다."},{"n":"운전석 열선시트","d":"시동 상태에서 해당 좌석 히터 버튼을 누르면 강약조절 표시등이 켜져 사용중임을 나타내고 해당 좌석이 따뜻해집니다."},{"n":"인조가죽시트","d":"차량의 시트에 부드럽고 편안한 착좌감을 제공하는 인조가죽 소재를 적용하였습니다."},{"n":"뒷유리 와이퍼&와셔 노즐","d":"차량의 후면 유리에 와이퍼와 와셔 노즐을 적용하여 후면 유리의 관리 및 시야확보에 용이합니다."}]},"KRTM312P04":{"desc":"","items":[{"n":"앞좌석 열선시트","d":"시동 상태에서 해당 좌석 히터 버튼을 누르면 강약조절 표시등이 켜져 사용중임을 나타내고 해당 좌석이 따뜻해집니다."},{"n":"운전석 시트 높이조절장치","d":"시트 높이를 조절하여 운전자가 올바르고 편안한 운전 자세를 갖출 수 있도록 도와드립니다."},{"n":"운전석 시트백 포켓","d":"운전석 후면에 물건을 적재할 수 있는 시트백 포켓을 적용하여 편의성을 높였습니다."},{"n":"운전석 시트벨트 높이조절장치","d":"시트벨트의 어깨 높이를 조절할 수 있어 몸에 맞는 시트벨트 착용이 가능합니다."},{"n":"운전석 통풍시트","d":"운전석 시트백과 쿠션부에 통풍 기능을 적용하여 하절기에 쾌적한 승차감을 제공합니다. 2단계까지 풍량 조절이 가능합니다."},{"n":"운전석 풀 폴딩시트","d":"운전석 등받이를 앞으로 접을 수 있게 설계해 앞좌석에서 뒷좌석, 그리고 러기지 공간을 잇는 풀 플랫 실내공간을 제공합니다."},{"n":"인조가죽시트","d":"차량의 시트에 부드럽고 편안한 착좌감을 제공하는 인조가죽 소재를 적용하였습니다."}]},"KRTM312P05":{"desc":"","items":[{"n":"고급형 센터콘솔","d":"앞좌석 센터콘솔에 서랍장이 내장되어 있어 작은 소품들을 수납할 수 있습니다."},{"n":"뒷좌석 슬라이딩 6:4 폴딩시트","d":"6:4의 비율로 완전히 접히는 폴딩시트로 뒷좌석에 짐을 넉넉하게 실을 수 있습니다."},{"n":"뒷좌석 열선시트","d":"뒷좌석에 열선시트를 적용하여 후석 승객의 편의성을 높였습니다."},{"n":"뒷좌석 C타입 USB 단자(충전용)","d":"뒷좌석 탑승객의 IT 기기 활용 편의성을 고려하여 C타입 USB 충전단자를 적용하였습니다."},{"n":"러기지 보드","d":"러기지 보드를 기본화하여 적재 편의 및 외관을 개선했습니다."},{"n":"러기지 언더트레이","d":"러기지 보드 하단에 수납을 위한 트레이를 적용하여 공간 활용성을 높이고 넓은 공간성을 확보했습니다."},{"n":"운전석 세이프티 파워윈도우","d":"윈도우에 끼이는 사고를 방지하기 위한 기능으로, 윈도우 원터치 자동 닫힘 기능이 작동 중일 때 물체 끼임 등에 의해 윈도우 닫힘이 막히면 자동으로 닫힘을 멈추고 일정 높이 만큼 다시 열립니다."}]},"KRTM312P08":{"desc":"","items":[{"n":"앞좌석 열선시트","d":"시동 상태에서 해당 좌석 히터 버튼을 누르면 강약조절 표시등이 켜져 사용중임을 나타내고 해당 좌석이 따뜻해집니다."},{"n":"운전석 시트 높이조절장치","d":"시트 높이를 조절하여 운전자가 올바르고 편안한 운전 자세를 갖출 수 있도록 도와드립니다."},{"n":"운전석 시트 암레스트","d":"운전석의 시트에 팔을 올릴 수 있는 암레스트를 적용하여 편안한 드라이빙 환경을 제공합니다."},{"n":"운전석 시트벨트 높이조절장치","d":"시트벨트의 어깨 높이를 조절할 수 있어 몸에 맞는 시트벨트 착용이 가능합니다."},{"n":"인조가죽시트","d":"차량의 시트에 부드럽고 편안한 착좌감을 제공하는 인조가죽 소재를 적용하였습니다."},{"n":"뒷유리 와이퍼&와셔 노즐","d":"차량의 후면 유리에 와이퍼와 와셔 노즐을 적용하여 후면 유리의 관리 및 시야확보에 용이합니다."}]},"KRTM312112":{"desc":"-","items":[]},"KRTM312P02":{"desc":"","items":[{"n":"14인치 알로이 휠","d":"-"},{"n":"LED 리어 콤비네이션램프","d":"간접광 그래픽과 균일한 점등필링으로 고급감과 정교한 이미지로 후면 디자인의 안정감을 높였습니다."},{"n":"LED 보조제동등","d":"후면 유리 상단에 장착되어 후방 차량에게 제동을 알리는 보조제동등에 LED를 적용하여 조금 더 명확한 제동 의사를 전달합니다."},{"n":"LED 주간 주행등","d":"시동 「ON」 시 주간주행등(DRL)이 자동으로 켜져 낮 시간에 다른 사람들이 차량을 쉽게 볼 수 있도록 하여 사고 예방에 도움을 줍니다."},{"n":"프로젝션 헤드램프","d":"주변이 어두울 때, 전방을 비춰 가야 할 길을 보여주고 내 위치를 다른 운전자에게 알려 안전에 도움을 줍니다. - 프로젝션 : 둥근 렌즈를 이용하여 빛을 직접 투사하는 방식"}]},"KRTM312P10":{"desc":"","items":[{"n":"운전석 통풍시트","d":"운전석 시트백과 쿠션부에 통풍 기능을 적용하여 하절기에 쾌적한 승차감을 제공합니다. 2단계까지 풍량 조절이 가능합니다."},{"n":"운전석 풀 폴딩시트","d":"운전석 등받이를 앞으로 접을 수 있게 설계해 앞좌석에서 뒷좌석, 그리고 러기지 공간을 잇는 풀 플랫 실내공간을 제공합니다."}]}},"imageSource":"https://www.kia.com/content/dam/kwp/kr/ko/vehicles/represent/krtm312/ray-ev_tmjc5vn3i_a_m9y.png","media":{"ext":["img/kia-ray-ev-x1.webp","img/kia-ray-ev-x2.webp"],"int":["img/kia-ray-ev-i1.webp","img/kia-ray-ev-i2.webp","img/kia-ray-ev-i3.webp"],"hero":"img/kia-ray-ev.webp","heroType":"cut"}}