ectronic Parking Brake(전자식 파킹 브레이크)의 약자로, 간단한 버튼 조작만으로 파킹브레이크가 작동 및 해제되고, 출발 시에는 자동으로 해제되어 더욱 편리한 드라이빙이 가능합니다. - 오토홀드 : 브레이크 페달을 밟고 차량이 정지한 후 브레이크 페달에서 발을 떼고 있어도 정지 상태를 유지하는 기능입니다."}]},"KRTM311P02":{"desc":"","items":[{"n":"LED 리어 콤비네이션 램프","d":"간접광 그래픽과 균일한 점등필링으로 고급감과 정교한 이미지로 후면 디자인의 안정감을 높였습니다."},{"n":"LED 보조제동등","d":"후면 유리 상단에 장착되어 후방 차량에게 제동을 알리는 보조제동등에 LED를 적용하여 조금 더 명확한 제동 의사를 전달합니다."},{"n":"LED 주간 주행등","d":"엔진 시동 시 주간주행등(DRL)이 자동으로 켜져 낮 시간에 다른 사람들이 차량을 쉽게 볼 수 있도록 하여 사고 예방에 도움을 줍니다."},{"n":"프로젝션 헤드램프","d":"주변이 어두울 때, 전방을 비춰 가야 할 길을 보여주고 내 위치를 다른 운전자에게 알려 안전에 도움을 줍니다. - 프로젝션 : 둥근 렌즈를 이용하여 빛을 직접 투사하는 방식"}]},"KRTM311P04":{"desc":"","items":[{"n":"앞좌석 열선시트","d":"시동 상태에서 해당 좌석 히터 버튼을 누르면 강약조절 표시등이 켜져 사용중임을 나타내고 해당 좌석이 따뜻해집니다."},{"n":"운전석 시트 높이조절 장치","d":"시트 높이를 조절하여 운전자가 올바르고 편안한 운전 자세를 갖출 수 있도록 도와드립니다."},{"n":"운전석 시트백 포켓","d":"운전석 후면에 물건을 적재할 수 있는 시트백 포켓을 적용하여 편의성을 높였습니다."},{"n":"운전석 시트벨트 높이조절 장치","d":"시트벨트의 어깨 높이를 조절할 수 있어 몸에 맞는 시트벨트 착용이 가능합니다."},{"n":"운전석 통풍시트","d":"운전석 시트백과 쿠션부에 통풍 기능을 적용하여 하절기에 쾌적한 승차감을 제공합니다. 2단계까지 풍량 조절이 가능합니다."},{"n":"운전석 풀 폴딩시트","d":"운전석 등받이를 앞으로 접을 수 있게 설계해 앞좌석에서 뒷좌석, 그리고 러기지 공간을 잇는 풀 플랫 실내공간을 제공합니다."},{"n":"인조가죽시트","d":"차량의 시트에 부드럽고 편안한 착좌감을 제공하는 인조가죽 소재를 적용하였습니다."}]},"KRTM311P01":{"desc":"","items":[{"n":"버튼시동 스마트키 시스템(원격시동 포함)","d":"스마트키를 휴대하고 있는 것만으로도 도어(또는 테일게이트)의 잠금/해제가 가능하고 버튼을 눌러 엔진 시동을 걸 수 있는 장치입니다."}]},"KRTM311P10":{"desc":"","items":[{"n":"LED 맵램프","d":"헤드라이닝에 적용된 맵램프에 백색 LED를 적용하여 점등 시 높은 시인성과 고급스러운 분위기를 제공합니다."},{"n":"대용량 루프 콘솔","d":"앞좌석 대용량 루프 콘솔에 수납공간이 있어 작은 소품들을 깔끔하게 보관할 수 있습니다."},{"n":"선글라스 케이스","d":"룸미러 상단에 위치한 보관함으로 선글라스 등 안경을 보관할 때 사용할 수 있습니다."},{"n":"전자식 룸미러","d":"전자식 룸미러(Electronic Chromic Mirror)는 야간 주행 시 뒤차의 전조등에 의해 실내 미러에 들어오는 빛을 센서로 자동 감지하고 미러의 반사율을 자동으로 낮추어 운전자의 눈부심을 감소시키는 장치입니다."},{"n":"공기청정 모드","d":"차량 실내로 들어오는 대기오염 물질의 유입을 차단하고 오염된 실내 공기를 정화시켜 쾌적한 실내 환경을 제공합니다. ※ 미세먼지 센서 미적용"},{"n":"풀오토 에어컨","d":"차량 내부의 각종 공조 기능을 오토로 편리하게 이용할 수 있고 사용자가 설정한 온도를 자동으로 조절 및 유지하여 쾌적한 차량 내부 환경을 조성합니다."},{"n":"하이패스 자동결제 시스템","d":"유료 도로로 진출입 시 통행료가 자동 결제되는 장치입니다."},{"n":"4스피커","d":"차량 내부에 4개의 스피커를 장착하여 차량 내부에서 다양한 인포테인먼트를 즐길 수 있습니다."},{"n":"8인치 내비게이션(기아커넥트, 폰 프로젝션, 인카페이먼트)","d":"정밀한 지도를 기반으로 정확한 위치 정보 및 커넥티드카 차량의 실시간 정보를 활용해 정확하고 빠른 경로 안내 서비스를 전달하며, 클러스터에 내비게이션 요약 정보 표시 제공 등 다양한 차량 연동 기능을 제공합니다. 원격 제어 서비스, 안전 보안 서비스 및 카카오 통합 AI플랫폼 kakao i(카카오i)를 활용한 음성 인식 차량 제어 서비스 등이 제공되는 첨단 커넥티드카 서비스 Kia Conn…"},{"n":"내비게이션 무선 업데이트","d":"차량이 자동으로 서버에 연결하여 내비게이션의 소프트웨어와 지도의 버전을 확인하고 업데이트하는 기능으로 기존 수동 업데이트의 번거로움 없이 최신 버전의 지도와 소프트웨어를 이용할 수 있습니다."},{"n":"샤크핀 안테나","d":"상어 지느러미 형상의 안테나로 오디오 전원 스위치를 「ON」 하면 안테나가 전파를 수신합니다."},{"n":"후방 모니터","d":"후방 차량 후방 영상을 차 안에서 모니터로 확인하여 쉽고 안전하게 주차할 수 있도록 도와주는 주차 안전 기능입니다."}]},"KRTM311P11":{"desc":"","items":[{"n":"전자식 룸미러","d":"전자식 룸미러(Electronic Chromic Mirror)는 야간 주행 시 뒤차의 전조등에 의해 실내 미러에 들어오는 빛을 센서로 자동 감지하고 미러의 반사율을 자동으로 낮추어 운전자의 눈부심을 감소시키는 장치입니다."},{"n":"공기청정 모드","d":"차량 실내로 들어오는 대기오염 물질의 유입을 차단하고 오염된 실내 공기를 정화시켜 쾌적한 실내 환경을 제공합니다. ※ 미세먼지 센서 미적용"},{"n":"풀오토 에어컨","d":"차량 내부의 각종 공조 기능을 오토로 편리하게 이용할 수 있고 사용자가 설정한 온도를 자동으로 조절 및 유지하여 쾌적한 차량 내부 환경을 조성합니다."},{"n":"하이패스 자동결제 시스템","d":"유료 도로로 진출입 시 통행료가 자동 결제되는 장치입니다."},{"n":"4스피커","d":"차량 내부에 4개의 스피커를 장착하여 차량 내부에서 다양한 인포테인먼트를 즐길 수 있습니다."},{"n":"8인치 내비게이션(기아커넥트, 폰 프로젝션, 인카페이먼트)","d":"정밀한 지도를 기반으로 정확한 위치 정보 및 커넥티드카 차량의 실시간 정보를 활용해 정확하고 빠른 경로 안내 서비스를 전달하며, 클러스터에 내비게이션 요약 정보 표시 제공 등 다양한 차량 연동 기능을 제공합니다. 원격 제어 서비스, 안전 보안 서비스 및 카카오 통합 AI플랫폼 kakao i(카카오i)를 활용한 음성 인식 차량 제어 서비스 등이 제공되는 첨단 커넥티드카 서비스 Kia Conn…"},{"n":"내비게이션 무선 업데이트","d":"차량이 자동으로 서버에 연결하여 내비게이션의 소프트웨어와 지도의 버전을 확인하고 업데이트하는 기능으로 기존 수동 업데이트의 번거로움 없이 최신 버전의 지도와 소프트웨어를 이용할 수 있습니다."},{"n":"샤크핀 안테나","d":"상어 지느러미 형상의 안테나로 오디오 전원 스위치를 「ON」 하면 안테나가 전파를 수신합니다."},{"n":"후방 모니터","d":"후방 차량 후방 영상을 차 안에서 모니터로 확인하여 쉽고 안전하게 주차할 수 있도록 도와주는 주차 안전 기능입니다."}]},"KRTM311123":{"desc":"-","items":[]},"KRTM311P14":{"desc":"","items":[{"n":"가죽 변속기 노브","d":"변속기 노브에 가죽 소재를 적용하여 부드러움을 한층 더 높여주는 상품입니다."},{"n":"가죽 스티어링 휠(블랙 하이그로시 가니쉬 포함)","d":"스티어링 휠의 소재를 가죽으로 적용하여 우수한 그립감과 감촉을 제공합니다."},{"n":"운전석 통풍시트","d":"운전석 시트백과 쿠션부에 통풍 기능을 적용하여 하절기에 쾌적한 승차감을 제공합니다. 2단계까지 풍량 조절이 가능합니다."},{"n":"운전석 풀 폴딩시트","d":"운전석 등받이를 앞으로 접을 수 있게 설계해 앞좌석에서 뒷좌석, 그리고 러기지 공간을 잇는 풀 플랫 실내공간을 제공합니다."},{"n":"열선 스티어링 휠","d":"스티어링 휠에 히팅기능을 적용하여 따뜻한 그립감을 느낄 수 있습니다."}]},"KRTM311P12":{"desc":"","items":[{"n":"전자식 룸미러","d":"전자식 룸미러(Electronic Chromic Mirror)는 야간 주행 시 뒤차의 전조등에 의해 실내 미러에 들어오는 빛을 센서로 자동 감지하고 미러의 반사율을 자동으로 낮추어 운전자의 눈부심을 감소시키는 장치입니다."},{"n":"공기청정 모드","d":"차량 실내로 들어오는 대기오염 물질의 유입을 차단하고 오염된 실내 공기를 정화시켜 쾌적한 실내 환경을 제공합니다. ※ 미세먼지 센서 미적용"},{"n":"풀오토 에어컨","d":"차량 내부의 각종 공조 기능을 오토로 편리하게 이용할 수 있고 사용자가 설정한 온도를 자동으로 조절 및 유지하여 쾌적한 차량 내부 환경을 조성합니다."},{"n":"하이패스 자동결제 시스템","d":"유료 도로로 진출입 시 통행료가 자동 결제되는 장치입니다."},{"n":"8인치 내비게이션(기아커넥트, 폰 프로젝션, 인카페이먼트)","d":"정밀한 지도를 기반으로 정확한 위치 정보 및 커넥티드카 차량의 실시간 정보를 활용해 정확하고 빠른 경로 안내 서비스를 전달하며, 클러스터에 내비게이션 요약 정보 표시 제공 등 다양한 차량 연동 기능을 제공합니다. 원격 제어 서비스, 안전 보안 서비스 및 카카오 통합 AI플랫폼 kakao i(카카오i)를 활용한 음성 인식 차량 제어 서비스 등이 제공되는 첨단 커넥티드카 서비스 Kia Conn…"},{"n":"내비게이션 무선 업데이트","d":"차량이 자동으로 서버에 연결하여 내비게이션의 소프트웨어와 지도의 버전을 확인하고 업데이트하는 기능으로 기존 수동 업데이트의 번거로움 없이 최신 버전의 지도와 소프트웨어를 이용할 수 있습니다."}]},"KRTM311P08":{"desc":"","items":[{"n":"전자식 룸미러","d":"전자식 룸미러(Electronic Chromic Mirror)는 야간 주행 시 뒤차의 전조등에 의해 실내 미러에 들어오는 빛을 센서로 자동 감지하고 미러의 반사율을 자동으로 낮추어 운전자의 눈부심을 감소시키는 장치입니다."},{"n":"공기청정 모드","d":"차량 실내로 들어오는 대기오염 물질의 유입을 차단하고 오염된 실내 공기를 정화시켜 쾌적한 실내 환경을 제공합니다. ※ 미세먼지 센서 미적용"},{"n":"풀오토 에어컨","d":"차량 내부의 각종 공조 기능을 오토로 편리하게 이용할 수 있고 사용자가 설정한 온도를 자동으로 조절 및 유지하여 쾌적한 차량 내부 환경을 조성합니다."},{"n":"하이패스 자동결제 시스템","d":"유료 도로로 진출입 시 통행료가 자동 결제되는 장치입니다."},{"n":"6스피커","d":"차량의 공간에 장착되어 있는 6개의 스피커로 차량에서 즐길 수 있는 다양한 인포테인먼트를 즐길 수 있습니다."},{"n":"8인치 내비게이션(기아커넥트, 폰 프로젝션, 인카페이먼트)","d":"정밀한 지도를 기반으로 정확한 위치 정보 및 커넥티드카 차량의 실시간 정보를 활용해 정확하고 빠른 경로 안내 서비스를 전달하며, 클러스터에 내비게이션 요약 정보 표시 제공 등 다양한 차량 연동 기능을 제공합니다. 원격 제어 서비스, 안전 보안 서비스 및 카카오 통합 AI플랫폼 kakao i(카카오i)를 활용한 음성 인식 차량 제어 서비스 등이 제공되는 첨단 커넥티드카 서비스 Kia Conn…"},{"n":"내비게이션 무선 업데이트","d":"차량이 자동으로 서버에 연결하여 내비게이션의 소프트웨어와 지도의 버전을 확인하고 업데이트하는 기능으로 기존 수동 업데이트의 번거로움 없이 최신 버전의 지도와 소프트웨어를 이용할 수 있습니다."},{"n":"샤크핀 안테나","d":"상어 지느러미 형상의 안테나로 오디오 전원 스위치를 「ON」 하면 안테나가 전파를 수신합니다."},{"n":"후방 모니터","d":"후방 차량 후방 영상을 차 안에서 모니터로 확인하여 쉽고 안전하게 주차할 수 있도록 도와주는 주차 안전 기능입니다."}]},"KRTM311P09":{"desc":"","items":[{"n":"6스피커","d":"차량의 공간에 장착되어 있는 6개의 스피커로 차량에서 즐길 수 있는 다양한 인포테인먼트를 즐길 수 있습니다."},{"n":"8인치 내비게이션(기아커넥트, 폰 프로젝션, 인카페이먼트)","d":"정밀한 지도를 기반으로 정확한 위치 정보 및 커넥티드카 차량의 실시간 정보를 활용해 정확하고 빠른 경로 안내 서비스를 전달하며, 클러스터에 내비게이션 요약 정보 표시 제공 등 다양한 차량 연동 기능을 제공합니다. 원격 제어 서비스, 안전 보안 서비스 및 카카오 통합 AI플랫폼 kakao i(카카오i)를 활용한 음성 인식 차량 제어 서비스 등이 제공되는 첨단 커넥티드카 서비스 Kia Conn…"},{"n":"내비게이션 무선 업데이트","d":"차량이 자동으로 서버에 연결하여 내비게이션의 소프트웨어와 지도의 버전을 확인하고 업데이트하는 기능으로 기존 수동 업데이트의 번거로움 없이 최신 버전의 지도와 소프트웨어를 이용할 수 있습니다."}]},"KRTM311P06":{"desc":"","items":[{"n":"안전 하차 경고","d":"정차 시, 탑승자가 하차를 위해 도어를 열 때 후측방에서 접근하는 차량과의 위험이 감지되면 경고해주는 기능입니다."},{"n":"후방 교차 충돌방지 보조","d":"후진 중 좌/우측에서 다가오는 차량을 인식하여 충돌 위험이 판단되면 경고문 표시와 경고음 등으로 운전자에게 알려주고, 충돌하지 않도록 제동을 도와줍니다."},{"n":"후측방 충돌 경고","d":"차로 변경을 위하여 방향지시등 스위치 조작 시, 후측방 차량과 충돌 위험이 감지되면 경고해 줍니다."},{"n":"후측방 충돌방지 보조(전진 출차)","d":"차로 변경을 위하여 방향지시등 스위치 조작 시, 후측방 차량과 충돌 위험이 감지되면 경고해 줍니다. 평행 주차 상태에서 전진 출차 중 후측방 차량과 충돌 위험이 감지되면 자동으로 제동을 도와줍니다."}]},"KRTM311P07":{"desc":"","items":[{"n":"8인치 디스플레이 오디오","d":"8인치 터치 타입 LCD 모니터를 기반으로 MP3/라디오, 블루투스, 후방 모니터, 폰 프로젝션 등 핵심 편의 기능을 적용했습니다."},{"n":"샤크핀 안테나","d":"상어 지느러미 형상의 안테나로 오디오 전원 스위치를 「ON」 하면 안테나가 전파를 수신합니다."},{"n":"후방 모니터","d":"후방 차량 후방 영상을 차 안에서 모니터로 확인하여 쉽고 안전하게 주차할 수 있도록 도와주는 주차 안전 기능입니다."}]},"KRTM311P13":{"desc":"","items":[{"n":"가죽 변속기 노브","d":"변속기 노브에 가죽 소재를 적용하여 부드러움을 한층 더 높여주는 상품입니다."},{"n":"가죽 스티어링 휠(블랙 하이그로시 가니쉬 포함)","d":"스티어링 휠의 소재를 가죽으로 적용하여 우수한 그립감과 감촉을 제공합니다."},{"n":"열선 스티어링 휠","d":"스티어링 휠에 히팅기능을 적용하여 따뜻한 그립감을 느낄 수 있습니다."}]},"KRTM311P05":{"desc":"","items":[{"n":"고급형 센터콘솔","d":"앞좌석 센터콘솔에 서랍장이 내장되어 있어 작은 소품들을 수납할 수 있습니다."},{"n":"뒷좌석 열선시트","d":"뒷좌석에 열선시트를 적용하여 후석 승객의 편의성을 높였습니다."},{"n":"뒷좌석 C타입 USB 단자(충전용)","d":"뒷좌석 탑승객의 IT 기기 활용 편의성을 고려하여 C타입 USB 충전단자를 적용하였습니다."},{"n":"운전석 세이프티 파워윈도우","d":"윈도우에 끼이는 사고를 방지하기 위한 기능으로, 윈도우 원터치 자동 닫힘 기능이 작동 중일 때 물체 끼임 등에 의해 윈도우 닫힘이 막히면 자동으로 닫힘을 멈추고 일정 높이 만큼 다시 열립니다."}]},"KRTM311124":{"desc":"-","items":[]}},"imageSource":"https://www.kia.com/content/dam/kwp/kr/ko/vehicles/represent/krtm311/ray_tmjc5af3i_a_m9y.png"}