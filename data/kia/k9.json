,{"n":"동승석 이지 억세스","c":"KRJR296144"}]},{"cat":"인포테인먼트","items":[{"n":"14.5인치 내비게이션(기아 커넥트, 폰 프로젝션, 인카페이먼트)","c":"KRJR296127"},{"n":"내비게이션/클러스터 무선 업데이트","c":"KRJR296128"},{"n":"필기인식 통합 컨트롤러","c":"KRJR296129"},{"n":"액티브 엔진 사운드","c":"KRJR296132"},{"n":"스티어링 휠 오디오 리모컨","c":"KRJR296133"},{"n":"블루투스 핸즈프리","c":"KRJR296134"},{"n":"USB 단자(데이터리딩용)","c":"KRJR296143"},{"n":"증강현실 내비게이션","c":"KRJR296135"}]},{"cat":"베스트 셀렉션 Ⅱ","items":[{"n":"프리미엄 팩","c":"KRJR296P04","new":1},{"n":"Lexicon 프리미엄 사운드","c":"KRJR296131","new":1},{"n":"VIP 컬렉션","c":"KRJR296P05","new":1},{"n":"VIP 컬렉션+","c":"KRJR296P06","new":1}]}],"adds":[{"cat":"베스트 셀렉션 Ⅱ","items":[{"n":"프리미엄 팩","c":"KRJR296P04"},{"n":"Lexicon 프리미엄 사운드","c":"KRJR296131"},{"n":"VIP 컬렉션","c":"KRJR296P05"},{"n":"VIP 컬렉션+","c":"KRJR296P06"}]}],"opts":[{"n":"스노우 화이트 펄","c":"KRJR296051","p":80000,"g":"옵션","note":""},{"n":"선루프","c":"KRJR296050","p":790000,"g":"옵션","note":""},{"n":"빌트인 캠","c":"KRJR296124","p":740000,"g":"옵션","note":""},{"n":"뒷좌석 듀얼 모니터","c":"KRJR296136","p":2470000,"g":"옵션","note":""},{"n":"차량 보호 필름","c":"KRJR296137","p":540000,"g":"기아 순정 액세서리","note":""}],"img":"https://www.kia.com/content/dam/kwp/kr/ko/vehicles/represent/krjr296/k9_jrjs4bpa9_p_swp.png"}],"notes":[]}],"packages":{"KRJR296P01":{"desc":"","items":[{"n":"후방 주차 충돌방지 보조","d":"주차 또는 출차 시 후진 중 보행자 및 장애물과의 충돌이 예상되면 운전자에게 경고하고, 충돌 위험이 높아지면 자동으로 제동을 도와줍니다."},{"n":"서라운드 뷰 모니터","d":"차량 외부에 장착된 4대의 카메라를 통해 주차 또는 주행 공간을 보여줌으로써 주차 및 좁은 공간 통과 시 운전 편의성을 높였습니다."},{"n":"후측방 모니터","d":"방향지시등 조작 시 측방 카메라를 활용하여 해당 방향의 후측방 영상을 클러스터 화면에 표시함으로써 아웃사이드 미러만으로 확보되지 않던 사각지대 영역의 시야를 확보할 수 있습니다."},{"n":"원격 스마트 주차 보조(직각 주차 및 평행 주차, 출차 기능 포함)","d":"차량 외부에서 원격으로 주차 및 출차를 도와주고 탑승 후 조작 시에는 조향, 차속, 변속을 자동으로 제어하여 주차 및 출차를 도와줍니다."},{"n":"증강현실 내비게이션","d":"실제 주행 영상 위에 안내 지점과 진출 방향이 표시되어 직관적으로 운행정보를 파악할 수 있습니다. 목적지 표시, 스마트 크루즈 컨트롤 등 다양한 정보를 세심하게 표현해 줍니다."}]},"KRJR296131":{"desc":"고급 서라운드 기능과 음질 보상 기술을 적용하여 원음에 가까운 입체적 사운드를 구현합니다.","items":[]},"KRJR296114":{"desc":"정보 표시 위치 최적화는 물론, AV 조작 등 스위치 조작 결과를 표시하며, 영상 사이즈 및 선명도 증대로 높은 편의를 제공합니다.","items":[]},"KRJR296P05":{"desc":"","items":[{"n":"뒷좌석 파워시트","d":"뒷좌석 좌/우측 시트가 독립적으로 구성됨에 따라 더욱 안락하고 고급스러운 실내 거주성을 구현하였습니다."},{"n":"뒷좌석 냉방/통풍시트","d":"시트백 및 시트 쿠션에 열전 소자를 활용한 냉방 통풍 기능을 적용하여 더운 실내에서도 단시간 내 쾌적한 착좌감을 제공합니다."},{"n":"뒷좌석 에어셀타입 허리지지대","d":"정교하게 조절할 수 있는 에어셀 타입을 적용하여 장거리 주행 시에도 안락한 승차감을 제공합니다."},{"n":"뒷좌석 윙아웃 헤드레스트","d":"헤드레스트의 좌/우를 손으로 잡고 안쪽으로 당겨 사용할 수 있으며 탑승자의 머리 지지를 위한 편의장치입니다."},{"n":"뒷좌석 화장 거울","d":"뒷좌석 승객의 편의를 위한 거울로 실내등과 함께 장착되어 있습니다. 뒷좌석 화장 거울은 커버를 눌러 열고, 밀어 올려서 닫을 수 있습니다."},{"n":"어드밴스드 3존 에어컨(B필라 에어벤트 포함)","d":"뒷좌석을 위한 별도의 블로워 및 B필라 에어벤트를 탑재하여 뒷좌석 냉난방의 수준을 높였습니다."}]},"KRJR296050":{"desc":"차량 루프에 선루프를 장착하여 뛰어난 개방감과 채광을 느낄 수 있으며 공기를 순환시켜 실내 공기질을 개선할 수 있습니다.","items":[]},"KRJR296P02":{"desc":"","items":[{"n":"인조가죽감싸기(크래쉬패드상단, 도어어퍼트림)","d":"자동차 계기판과 중앙 디스플레이 등 각종 전자장비를 감싸고 있는 기본 틀인 크래쉬패드상단과 자동차 도어 안쪽의 잠금장치, 스피커 등을 덮고 있는 도어 트림의 상단 부분을 인조가죽 소재로 적용하였습니다."},{"n":"뒷좌석 측면 수동 선커튼","d":"뒷좌석 유리를 통해 들어오는 외부 광선을 차단할 때 사용하는 커튼으로, 커튼 고리를 잡아 올려 상단에 장착된 후크에 걸어 사용할 수 있습니다."},{"n":"후면 전동 선커튼","d":"후면 글라스의 97%까지 커버하는 동급 최대 수준 차광 면적 확보 및 기존 대비 작동 소음 저감으로 뒷좌석 승객 편의성을 높였습니다."}]},"KRJR296137":{"desc":"차량에 투명 보호 필름을 부착하여 일상 생활 중 발생하는 표면 스크래치를 예방해줍니다. - 적용 부위 : 프론트 범퍼 사이드/하단, 리어 범퍼 사이드/어퍼, 아웃사이드 미러, 도어 스텝, 전/후석 도어 중앙부, 내비게이션 디스플레이","items":[]},"KRJR296P07":{"desc":"","items":[{"n":"앞245/45 R19&뒤275/40 R19 외산 타이어&다크 스퍼터링 휠","d":"-"}]},"KRJR296124":{"desc":"주행 중 전후방 카메라를 통해 영상을 기록하고, 스마트폰으로 전송할 수 있는 장치입니다.","items":[]},"KRJR296P04":{"desc":"","items":[{"n":"최고급 가죽 내장재(크래쉬패드 상단, 도어 어퍼 트림, 도어 암레스트, 콘솔 암레스트 상단 등)","d":"인테리어 내장재에 최고급 가죽을 적용하였습니다 - 크래쉬패드 : 자동차 계기판과 중앙 디스플레이 등 각종 전자장비를 감싸고 있는 기본 틀 - 도어 어퍼 트림 : 자동차 도어 안쪽의 잠금장치, 스피커 등을 덮고 있는 부분의 상단 - 도어 암레스트 : 차량 도어 안쪽 팔걸이 - 콘솔 암레스트 : 운전석과 동승석 사이에 위치한 박스형태의 수납공간 위의 팔걸이"},{"n":"리얼 우드 내장재","d":"실제 나무를 사용한 내장재로 진짜 나무가 전하는 특유의 촉감을 느낄 수 있습니다."},{"n":"앰비언트 라이트","d":"선명한 컬러를 자랑하는 앰비언트 라이트로 프리미엄 공간을 은은하게 물들여 나만의 감성 공간을 연출합니다."},{"n":"인터랙티브 조명","d":"내비게이션 또는 공조 스위치 조작을 위해 손 접근 시, 스위치 조명을 증대하여 야간 시인성은 물론 고급감까지 향상시켰습니다."},{"n":"퀼팅 나파 가죽시트","d":"시트백, 쿠션까지 퀼팅 패턴을 확대 적용하여 고급스럽고 편안한 인테리어 감성을 구현하였습니다."}]},"KRJR296051":{"desc":"-","items":[]},"KRJR296007":{"desc":"전방 카메라와 내비게이션 정보를 통해 전방 노면 정보를 미리 인지하여 노면에 적합한 서스펜션 제어로 최적의 승차감을 제공합니다.","items":[]},"KRJR296008":{"desc":"AWD는 All Wheel Drive의 약자로 다양한 노면에 최적화된 트랙션 성능으로 안정적 주행이 가능하고, 드라이브 모드에 따라 후륜 구동력을 가변 제어함으로써 어떤 상황 및 노면에서도 최상의 구동력을 제공합니다.","items":[]},"KRJR296136":{"desc":"모니터에 터치 기능을 적용하였으며, 각 모니터의 독립적인 콘텐츠 이용이 가능합니다.","items":[]}},"imageSource":"https://www.kia.com/content/dam/kwp/kr/ko/vehicles/represent/krjr296/k9_jrjs4ck39_a_swp.png","media":{"ext":["img/kia-k9-x1.webp","img/kia-k9-x2.webp"],"int":["img/kia-k9-i1.webp","img/kia-k9-i2.webp","img/kia-k9-i3.webp"],"hero":"img/kia-k9.webp","heroType":"cut"}}